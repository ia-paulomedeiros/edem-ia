{
  "name": "WA 03 — Envio manual (reage à linha em messages)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "supabase/messages",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000001",
      "name": "Webhook (Supabase Database Webhook: INSERT em messages)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "supabase-messages"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "s0",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.SUPABASE_WEBHOOK_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "s1",
              "leftValue": "={{ $json.body.type }}",
              "rightValue": "INSERT",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "s2",
              "leftValue": "={{ $json.body.record.direction }}",
              "rightValue": "out",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "s3",
              "leftValue": "={{ $json.body.record.sender }}",
              "rightValue": "^(humano|sistema|ia)$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "s4",
              "leftValue": "={{ $json.body.record.status }}",
              "rightValue": "pending",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000002",
      "name": "Mensagem pendente de envio?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select * from public.mensageria_destino($1);",
        "options": {
          "queryReplacement": "={{ $json.body.record.id }}"
        }
      },
      "id": "c3000000-0000-4000-8000-000000000003",
      "name": "Destino + provedor + token do Vault",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        420,
        -100
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Supabase (service_role)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.phone_number_id }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.template ? { messaging_product: 'whatsapp', to: $json.wa_id, type: 'template', template: $json.template } : { messaging_product: 'whatsapp', to: $json.wa_id, type: 'text', text: { body: $json.body } }) }}",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000004",
      "name": "Graph API: enviar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        -200
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update public.messages\n   set status = case when $2 is null then 'failed' else 'sent' end,\n       wa_message_id = $2,\n       error = $3\n where id = $1;",
        "options": {
          "queryReplacement": "={{ $('Destino + provedor + token do Vault').item.json.message_id }}, {{ $json.messages?.[0]?.id ?? null }}, {{ $json.error ? JSON.stringify($json.error).slice(0, 500) : null }}"
        }
      },
      "id": "c3000000-0000-4000-8000-000000000005",
      "name": "Marcar enviada / falha",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1080,
        -200
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Supabase (service_role)"
        }
      }
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.provider }}",
                    "rightValue": "meta_whatsapp",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "WhatsApp Cloud"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.provider }}",
                    "rightValue": "datacrazy",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Datacrazy"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Outro"
        }
      },
      "id": "e3000000-0000-4000-8000-000000000101",
      "name": "Provedor de mensageria",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        600,
        -100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.message_mark_failed($1::uuid, $2);",
        "options": {
          "queryReplacement": "={{ $json.message_id }}, Envio pelo Datacrazy ainda não implementado: falta a documentação da API (ver README, P3)."
        }
      },
      "id": "e3000000-0000-4000-8000-000000000102",
      "name": "Datacrazy: envio pendente (marca falha)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        840,
        60
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Supabase (service_role)"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.message_mark_failed($1::uuid, $2);",
        "options": {
          "queryReplacement": "={{ $json.message_id }}, Escritório sem mensageria ativa (cadastre o WhatsApp Cloud em Configurações → Integrações)."
        }
      },
      "id": "e3000000-0000-4000-8000-000000000103",
      "name": "Sem provedor (marca falha)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        840,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Supabase (service_role)"
        }
      }
    }
  ],
