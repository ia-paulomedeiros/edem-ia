      "id": "c3000000-0000-4000-8000-000000000014",
      "name": "Montar mensagem (texto, template ou mídia)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1480,
        -200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Monta o corpo da Graph API: template, mídia (link assinado do Storage) ou texto.\nconst e = $('Envio: destino, mídia e janela de 24h').item.json;\nconst base = { messaging_product: 'whatsapp', recipient_type: 'individual', to: e.wa_id };\nif (e.template) return { json: { ...e, graph_body: { ...base, type: 'template', template: e.template } } };\nif (e.media_tipo) {\n  const signed = $json.signedURL ?? $json.signedUrl;\n  if (!signed) return { json: { ...e, graph_body: null, erro: 'Falha ao gerar o link da mídia no Storage: ' + JSON.stringify($json.error ?? $json).slice(0, 300) } };\n  const t = e.media_tipo;                      // audio | document | image | video\n  const m = { link: $env.SUPABASE_URL + '/storage/v1' + signed };\n  if (t === 'document') m.filename = e.media?.filename ?? 'documento.pdf';\n  const caption = e.media?.caption ?? e.body;\n  if (t !== 'audio' && caption) m.caption = caption;\n  return { json: { ...e, graph_body: { ...base, type: t, [t]: m } } };\n}\nreturn { json: { ...e, graph_body: { ...base, type: 'text', text: { preview_url: true, body: e.body ?? '' } } } };"
      }
    },
