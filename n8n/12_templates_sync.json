              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "c1200000-0000-4000-8000-000000000001",
      "name": "A cada 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
