        "operation": "executeQuery",
        "query": "select (public.template_submitted($1::uuid, $2, $3, $4)).status as status;",
        "options": {
          "queryReplacement": "={{ $('Payload do template (template_submit_payload)').item.json.template_id }}, {{ $json.id ?? null }}, {{ $json.status ?? null }}, {{ $json.error ? (($json.error.message ?? '') + ' ' + JSON.stringify($json.error.description ?? $json.error)).slice(0, 500) : null }}"
        }
